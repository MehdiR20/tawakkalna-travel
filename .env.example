# PostgreSQL. On Neon: the pooled connection, and the direct one for schema changes.
DATABASE_URL="postgresql://user:password@host-pooler/dbname?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@host/dbname?sslmode=require"

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET="replace-me"
NEXTAUTH_URL="http://localhost:3100"

# The admin account created by `npm run db:seed`. Use a strong password of 12+ characters.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="replace-me"
